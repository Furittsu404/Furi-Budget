<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="add_expense"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_add"
        android:shortcutShortLabel="@string/shortcut_expense">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="app.furibudget"
            android:targetClass="app.furibudget.MainActivity">
            <extra android:name="route" android:value="add_expense" />
        </intent>
    </shortcut>
    <shortcut
        android:shortcutId="add_income"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_add"
        android:shortcutShortLabel="@string/shortcut_income">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="app.furibudget"
            android:targetClass="app.furibudget.MainActivity">
            <extra android:name="route" android:value="add_income" />
        </intent>
    </shortcut>
    <shortcut
        android:shortcutId="pay_bills"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_bills"
        android:shortcutShortLabel="@string/shortcut_bills">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="app.furibudget"
            android:targetClass="app.furibudget.MainActivity">
            <extra android:name="route" android:value="bills" />
        </intent>
    </shortcut>
</shortcuts>
